[Unit]
Description=SimLocation RemotePairing tunnel to the phone over WireGuard
Documentation=file:///opt/simlocation/deploy/README.md
Requires=wg-quick@wg-simloc.service
Wants=simlocation-firewall.service network-online.target
After=wg-quick@wg-simloc.service simlocation-firewall.service network-online.target
# Never give up: the phone comes and goes with Wi-Fi, and a stopped unit would
# need someone with SSH to bring it back.
StartLimitIntervalSec=0

[Service]
Type=simple
User=simlocation-tunnel
Group=simlocation-tunnel
Environment=HOME=/var/lib/simlocation-tunnel
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/simlocation-venv/bin/python /opt/simlocation/deploy/network_tunneld.py --self-test
ExecStart=/opt/simlocation-venv/bin/python -u /opt/simlocation/deploy/network_tunneld.py --config /etc/simlocation/network.json
Restart=always
RestartSec=10
TimeoutStopSec=20
StateDirectory=simlocation-tunnel
StateDirectoryMode=0700
UMask=0077
# Creating and addressing the TUN interface is all it needs root for.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
MemoryMax=256M

[Install]
WantedBy=multi-user.target
